---
const { title = "Nexus Coach", description = "Klarheit. Fokus. Entwicklung." } = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- PWA Manifest -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0d0d0d" />

    <!-- Favicon -->
    <link rel="icon" href="/icons/icon-192.png" />

    <style>
      body {
        margin: 0;
        background: #0d0d0d;
        color: #f5f5f5;
        font-family: system-ui, sans-serif;
      }
      main {
        padding: 1.5rem;
        max-width: 900px;
        margin: 0 auto;
      }
    </style>
  </head>

  <body>
    <main>
      <slot />
    </main>
<script src="/src/scripts/register-sw.js" type="module"></script>
  </body>
</html>
